{
    "Odoo Abstract Model": {
        "prefix": "odoo abstract model",
        "body": [
            "from odoo import api,fields,models",
            "",
            "class ${1:ModelName}(models.AbstractModel):",
            "    _name = '${2:model.name}'",
            "    _description = '${3:Model Description}'",
            "",
            "    name = fields.Char(string='Name', required=True)",
            "    ${4:active} = fields.Boolean(string='Active', default=True)"
        ],
        "description": "Create a new Odoo abstract model"
    },
    "Odoo Transient Model": {
        "prefix": "odoo transient model",
        "body": [
            "from odoo import api,fields,models",
            "",
            "class ${1:ModelName}(models.TransientModel):",
            "    _name = '${2:model.name}'",
            "    _description = '${3:Model Description}'",
            "",
            "    name = fields.Char(string='Name', required=True)",
            "    ${4:active} = fields.Boolean(string='Active', default=True)"
        ],
        "description": "Create a new Odoo transient model"
    },
    "Odoo Constraint": {
        "prefix": "odoo constraint",
        "description": "SQL constraint (models.Constraint replaces _sql_constraints since 19)",
        "body": [
            "_${1:name}_uniq = models.Constraint(",
            "    '${2:unique(name)}',",
            "    '${3:The name must be unique.}',",
            ")"
        ]
    }
}
