    "menus": {
      "explorer/context": [
        {
          "submenu": "cybrosys-assista-odoo-helper.mainMenu",
          "group": "navigation@1",
          "title": "Assista Odoo"
        },
        {
          "command": "cybrosys-assista-odoo-helper.addToInit",
          "group": "navigation@2",
          "when": "resourceExtname == .py || explorerSearchIsDirectory"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "cybrosys-assista-odoo-helper.odooModelTools",
          "group": "navigation@1",
          "title": "Odoo Model Tools",
          "when": "resourceLangId == python && cybrosys-assista-odoo-helper.isOdooModel"
        },
        {
          "command": "cybrosys-assista-odoo-helper.addToInit",
          "group": "navigation@2",
          "when": "resourceLangId == python"
        }
      ],
      "editor/context": [
        {
          "submenu": "cybrosys-assista-odoo-helper.odooModelTools",
          "group": "navigation@1",
          "title": "Odoo Model Tools",
          "when": "resourceLangId == python && cybrosys-assista-odoo-helper.isOdooModel"
        },
        {
          "command": "cybrosys-assista-odoo-helper.addToInit",
          "group": "navigation@2",
