    "snippets": [],
    "configuration": {
      "title": "Cybrosys Assista Odoo Helper",
      "properties": {
        "cybrosys-assista-odoo-helper.enableCodeStandardWarnings": {
          "type": "boolean",
          "default": false,
          "description": "Enable/disable Odoo code standard warnings and linting"
        },
        "cybrosys-assista-odoo-helper.odooVersion": {
          "type": "string",
          "enum": [
            "auto",
            "18",
            "19"
          ],
          "default": "auto",
          "description": "Target Odoo version for completions, lint rules, and scaffolding. Use 'auto' to detect from odoo/release.py."
        },
        "cybrosys-assista-odoo-helper.odooSourcePath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to Odoo source root (containing 'odoo/release.py') to help auto-detection."
        },
        "cybrosys-assista-odoo-helper.indexing.enableCSSIndexing": {
          "type": "boolean",
          "default": true,
          "description": "Enable scanning of CSS/SCSS files for class completion."
        },
        "cybrosys-assista-odoo-helper.indexing.enableAdvanceCSSIndexing": {
          "type": "boolean",
          "default": false,
          "description": "Enable advanced detailed indexing (storing file paths and line numbers) for CSS features like Go-to-Definition. Requires 'Enable CSS Indexing' to be on.",
          "markdownDescription": "Enable advanced detailed indexing (storing file paths and line numbers) for CSS features like Go-to-Definition. Requires `#cybrosys-assista-odoo-helper.indexing.enableCSSIndexing#` to be on."
        },
        "cybrosys-assista-odoo-helper.indexing.enableRegistryIndexing": {
          "type": "boolean",
          "default": true,
          "description": "Enable scanning of JavaScript/OWL files for Odoo registry entry completion (widgets, components, etc.)."
        },
        "cybrosys-assista-odoo-helper.indexing.enableCoreIndexing": {
          "type": "boolean",
          "default": true,
          "description": "Enable scanning of Python files for Odoo Models, Fields, and Functions. Highly recommended for full functionality."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "odoo-configurations",
          "title": "Odoo Configurations",
          "icon": "$(settings-gear)"
        }
      ]
    },
    "views": {
      "odoo-configurations": [
        {
          "type": "webview",
          "id": "cybrosys-assista-odoo-helper.configView",
          "name": "Odoo Server Config",
          "icon": "$(settings-gear)"
        }
      ]
    }
