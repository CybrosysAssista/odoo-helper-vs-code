{
  "name": "cybrosys-assista-odoo-helper",
  "displayName": "Cybrosys Assista: Odoo Helper",
  "icon": "logo/logo.png",
  "description": "VS Code extension focused on Odoo 18 and 19 development. Includes code completions, model/view scaffolding, XML/Python snippets, and decorator intelligence.",
  "version": "2.0.1",
  "publisher": "CybrosysTechnologiesOdooOfficialPartner",
  "author": {
    "name": "Cybrosys Technologies",
    "url": "https://www.cybrosys.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CybrosysAssista/Assista-VS-Code.git"
  },
  "bugs": {
    "url": "https://github.com/CybrosysAssista/Assista-VS-Code/issues"
  },
  "homepage": "https://github.com/CybrosysAssista/Assista-VS-Code#readme",
  "keywords": [
    "odoo",
    "odoo18",
    "odoo19",
    "odoo18-dev",
    "odoo-dev",
    "vscode",
    "vscode-extension",
    "xml",
    "python",
    "owl",
    "snippets",
    "scaffold",
    "decorators",
    "code-completion",
    "odoo-snippets",
    "odoo-module"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/__manifest__.py",
    "workspaceContains:**/odoo/release.py",
    "onLanguage:python",
    "onLanguage:xml"
  ],
