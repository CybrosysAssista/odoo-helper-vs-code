  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "eslint": "^8.54.0",
    "glob": "^10.3.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vscode-html-languageservice": "^5.6.1",
